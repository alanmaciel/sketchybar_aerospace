#!/usr/bin/env bash

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/themes.sh"

# A reload tears every item down and re-adds it, which takes long enough that
# the still-running workspace_pills controller (update_freq=1) fires into the
# gap and logs a screenful of "Set: Item not found" while half its --set calls
# are silently dropped. This flag tells that script to sit the reload out; it
# is cleared just before monitor_layout.sh runs at the bottom of this file.
SB_LOADING_FLAG="${TMPDIR:-/tmp}/sketchybar-config-loading"
: >"$SB_LOADING_FLAG"
trap 'rm -f "$SB_LOADING_FLAG"' EXIT


########################################
# BAR
########################################
sketchybar --bar \
  position=top \
  height=38 \
  blur_radius=0 \
  color="$BAR_BG"
  # border_color="$BAR_BORDER" \
  # border_width=1

########################################
# DEFAULTS
########################################
default=(
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color="$BAR_FG"
  label.color="$BAR_FG"
  padding_left=4
  padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

########################################
# AEROSPACE EVENT
########################################
sketchybar --add event aerospace_workspace_change
sketchybar --add event front_app_focus_changed
sketchybar --add event aerospace_window_change

########################################
# WORKSPACE PILLS (1–6) → spread across 1-3 monitors, see monitor_layout.sh
########################################

# Must match MAX_SLOTS in workspace_pills.sh. Bump if you regularly have
# more windows open in a single workspace.
WORKSPACE_MAX_WINDOWS=10

SPACES=("1" "2" "3" "4" "5" "6")

# Each pill is a bracket merging a "num" item (the workspace digit) with a
# fixed pool of "slot" items (one per potential window, up to
# WORKSPACE_MAX_WINDOWS). workspace_pills.sh (a single controller item, see
# below) fills in one slot per window with that app's icon and colors the
# focused window's icon differently, so the bracket's members render as a
# single pill. Which display each pill actually shows on is decided at
# runtime by monitor_layout.sh, not here — associated_display=1 below is
# just a startup default.
for sid in "${SPACES[@]}"; do
  sketchybar --add item "space.$sid.num" left \
    --set "space.$sid.num" \
      associated_display=1 \
      icon="$sid" \
      icon.padding_left=10 \
      icon.padding_right=10 \
      label.drawing=off \
      click_script="aerospace workspace $sid"

  SLOTS=()
  for i in $(seq 0 $((WORKSPACE_MAX_WINDOWS - 1))); do
    sketchybar --add item "space.$sid.slot.$i" left \
      --set "space.$sid.slot.$i" \
        associated_display=1 \
        drawing=off \
        icon.drawing=off \
        label.font="sketchybar-app-font:Regular:16.0" \
        label.padding_left=0 \
        label.padding_right=0
    SLOTS+=("space.$sid.slot.$i")
  done

  sketchybar --add bracket "space.$sid" "space.$sid.num" "${SLOTS[@]}" \
    --set "space.$sid" \
      background.color="$SPACE_BG" \
      background.corner_radius=5 \
      background.height=22 \
      background.drawing=on

  # Brackets ignore their own padding for spacing, so a plain spacer item is
  # the only way to put a visible gap between two pills.
  sketchybar --add item "space.$sid.gap" left \
    --set "space.$sid.gap" associated_display=1 icon.drawing=off label.drawing=off width=8
done

# Single invisible controller that updates every workspace pill in one
# script run (see workspace_pills.sh for why this is one item instead of
# one script per pill). update_freq=1 is a cheap polling fallback for
# window *closes*, which AeroSpace has no dedicated event for (unlike
# aerospace_window_change below, used for opens) — without it, closing a
# window in a non-focused workspace wouldn't refresh its pill until the
# next workspace switch.
sketchybar --add item workspace_pills left \
  --set workspace_pills drawing=off icon.drawing=off label.drawing=off \
    update_freq=1 \
    script="$PLUGIN_DIR/workspace_pills.sh" \
  --subscribe workspace_pills aerospace_workspace_change front_app_switched front_app_focus_changed aerospace_window_change


########################################
# RIGHT SIDE – DISPLAY 1 (Laptop)
########################################

sketchybar --add item clock right \
  --set clock \
      associated_display=1 \
      icon= \
      icon.color="$RIGHT_ICON" \
      label.color="$RIGHT_LABEL" \
      update_freq=15 \
      background.color="$SPACE_BG" \
      background.corner_radius=5 \
      background.height=24 \
      background.drawing=on \
      icon.padding_left=10 \
      icon.padding_right=4 \
      label.padding_left=2 \
      label.padding_right=10 \
      script="$PLUGIN_DIR/clock.sh" \
      click_script="$PLUGIN_DIR/clock.sh click"

