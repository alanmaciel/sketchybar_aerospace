sketchybar --add item battery_ext right \
  --subscribe battery_ext power_source_change \
  --set battery_ext \
      associated_display=2 \
      icon= \
      icon.color="$RIGHT_ICON" \
      label.color="$RIGHT_LABEL" \
      update_freq=30 \
      background.color="$SPACE_BG" \
      background.corner_radius=5 \
      background.height=24 \
      background.drawing=on \
      icon.padding_left=10 \
      icon.padding_right=4 \
      label.padding_left=2 \
      label.padding_right=10 \
      script="$PLUGIN_DIR/battery.sh" \
      click_script="$PLUGIN_DIR/battery.sh click"

########################################
# RIGHT SIDE – DISPLAY 3 (2nd external, only shown with 3 monitors)
########################################

sketchybar --add item clock_ext2 right \
  --set clock_ext2 \
      associated_display=3 \
      drawing=off \
      icon= \
      icon.color="$RIGHT_ICON" \
      label.color="$RIGHT_LABEL" \
      update_freq=15 \
      background.color="$SPACE_BG" \
      background.corner_radius=5 \
      background.height=24 \
      background.drawing=on \
      icon.padding_left=10 \
      icon.padding_right=4 \
      label.padding_left=2 \
      label.padding_right=10 \
      script="$PLUGIN_DIR/clock.sh" \
      click_script="$PLUGIN_DIR/clock.sh click"

sketchybar --add item battery_ext2 right \
  --subscribe battery_ext2 power_source_change \
  --set battery_ext2 \
      associated_display=3 \
      drawing=off \
      icon= \
      icon.color="$RIGHT_ICON" \
      label.color="$RIGHT_LABEL" \
      update_freq=30 \
      background.color="$SPACE_BG" \
      background.corner_radius=5 \
      background.height=24 \
      background.drawing=on \
      icon.padding_left=10 \
      icon.padding_right=4 \
      label.padding_left=2 \
      label.padding_right=10 \
      script="$PLUGIN_DIR/battery.sh" \
      click_script="$PLUGIN_DIR/battery.sh click"

########################################
# MONITOR LAYOUT ADAPTATION (1, 2 or 3 monitors)
########################################

sketchybar --add item monitor_layout right \
  --set monitor_layout drawing=off script="$PLUGIN_DIR/monitor_layout.sh" \
  --subscribe monitor_layout display_change

# Run once at startup, synchronously — backgrounding this let it race against
# a concurrent display_change replay firing on the --subscribe above right
# after startup, sometimes leaving a pill's associated_display unset.

# Every item exists from here on, so pill updates are safe again — and
# monitor_layout.sh ends by running workspace_pills.sh itself, which would
# otherwise sit this run out too.
rm -f "$SB_LOADING_FLAG"

"$PLUGIN_DIR/monitor_layout.sh"

########################################
# INITIAL UPDATE
########################################
sketchybar --update
